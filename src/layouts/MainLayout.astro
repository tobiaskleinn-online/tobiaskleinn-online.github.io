---
import '../styles/global.css';
import siteConfig from '../../site.config.mjs';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
interface Props {
	title?: string;
	hero?: boolean;
	description?: string;
}
const {
	title,
	hero = false,
	description = 'Photography and personal projects by Tobias Klein. Finding beauty in quiet details and exploring the ideas behind the image.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" type="image/x-icon" href={`${base}/${siteConfig.favicon}`} />
		<title>{title ? `${title} — ${siteConfig.owner}` : siteConfig.owner}</title>
		<script is:inline>
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('tobias-klein.theme');
				} catch {}
				document.documentElement.dataset.theme =
					theme === 'light' || theme === 'dark'
						? theme
						: matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
			})();
		</script>
	</head>
	<body class:list={{ 'has-photo-hero': hero }}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<NavBar />
		<main id="main-content"><slot /></main>
		<Footer />
	</body>
</html>

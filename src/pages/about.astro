---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout
	title="About"
	description="About Tobias Klein, photography, and the intersection of technology and art."
>
	<section class="shell">
		<div class="page-intro">
			<div class="eyebrow">Behind the photographs</div><h1>A little about me.</h1>
		</div>
		<div class="about-layout">
			<img
				class="about-image"
				src={`${base}/images/${siteConfig.profileImage}`}
				alt="Tobi reflected in a car mirror"
				width="720"
				height="720"
			/>
			<div class="about-copy"><AboutPage /></div>
		</div>
	</section>
</MainLayout>

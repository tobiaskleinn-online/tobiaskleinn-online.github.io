---
import { Moon, Sun } from 'lucide-astro';
import siteConfig from '../../site.config.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
---

<header class="site-header shell">
	<a href={`${base}/`} class="wordmark" aria-label={`${siteConfig.owner}, home`}
		>{siteConfig.owner}</a
	>
	<div class="header-actions">
		<nav class="site-nav" aria-label="Main navigation">
			<a
				href={`${base}/collections/`}
				aria-current={path.includes('/collections') ? 'page' : undefined}>Photography</a
			>
			<a
				href={`${base}/#projects`}
				aria-current={path.includes('/photography') ? 'page' : undefined}>Projects</a
			>
			<a href={`${base}/about/`} aria-current={path.includes('/about') ? 'page' : undefined}
				>About</a
			>
		</nav>
		<button
			class="theme-toggle"
			type="button"
			aria-label="Switch to dark mode"
			title="Switch to dark mode"
		>
			<Moon class="moon" aria-hidden="true" /><Sun class="sun" aria-hidden="true" />
		</button>
	</div>
</header>
<script>
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const preference = matchMedia('(prefers-color-scheme: dark)');
	function updateLabel() {
		const dark = document.documentElement.dataset.theme === 'dark';
		if (!button) return;
		button.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
		button.title = `Switch to ${dark ? 'light' : 'dark'} mode`;
	}
	button?.addEventListener('click', () => {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('tobias-klein.theme', theme);
		} catch {
			/* Theme still works without storage. */
		}
		updateLabel();
	});
	preference.addEventListener('change', () => {
		let stored;
		try {
			stored = localStorage.getItem('tobias-klein.theme');
		} catch {}
		if (stored !== 'dark' && stored !== 'light')
			document.documentElement.dataset.theme = preference.matches ? 'dark' : 'light';
		updateLabel();
	});
	updateLabel();
</script>

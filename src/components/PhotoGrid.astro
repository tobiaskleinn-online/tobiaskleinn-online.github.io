---
import justifiedLayout from 'justified-layout';
import PhotoCard from './PhotoCard.astro';
import type { Image } from '../data/galleryData';
interface Props {
	images: Image[];
}
const { images } = Astro.props;
// A complete initial layout is rendered at build time, even without JavaScript.
// The browser refines this geometry for its exact width without loading images.
const width = 1200;
const layout = justifiedLayout(
	images.map((image) => ({ width: image.src.width, height: image.src.height })),
	{
		containerWidth: width,
		containerPadding: 0,
		targetRowHeight: 300,
		boxSpacing: 10,
	},
);
---

{
	images.length ? (
		<div
			class="photo-grid justified-gallery"
			aria-label="Photo gallery"
			style={`aspect-ratio:${width}/${layout.containerHeight}`}
		>
			{images.map((image, index) => {
				const box = layout.boxes[index];
				const style = `left:${(box.left / width) * 100}%;top:${(box.top / layout.containerHeight) * 100}%;width:${(box.width / width) * 100}%;height:${(box.height / layout.containerHeight) * 100}%;`;
				return (
					<PhotoCard
						image={image}
						style={style}
						showCaption={false}
						priority={index < 3}
						sizes="(max-width: 650px) 90vw, (max-width: 900px) 50vw, 40vw"
					/>
				);
			})}
		</div>
	) : (
		<p class="empty-gallery">
			Photographs are on their way. Explore another collection in the meantime.
		</p>
	)
}
